# Code-signing material. Private keys must NEVER be committed; the public .cer
# is a generated build/deploy artifact and belongs in the deployment channel
# (GPO/Intune), not the repo. The signing scripts themselves ARE tracked.
*.pfx
*.p12
*.snk
*.key
packaging/sign/*.cer
!packaging/sign/*.ps1
tools/news_candidates.json
.agents/skills/*/drafts/*.json
.agents/skills/*/rejected/*.json
dist/sbom.json

# Editorial work belongs in the private workspace, including local drafts.
drafts/
tools/*_draft.json
tools/*_candidates.json
