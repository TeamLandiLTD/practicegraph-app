#!/bin/bash
#
# PracticeGraph installer, after the app is copied: open it for the person at
# the screen, as that person, so the install ends where the Windows one does
# (its finish dialog launches the app).
#
# Command-line and managed installs (`installer`, MDM) set
# COMMAND_LINE_INSTALL; nobody is watching those, so nothing is opened.
# Never fails the install.

set -u
APP="${PRACTICEGRAPH_INSTALL_APP:-/Applications/PracticeGraph.app}"

[ -n "${COMMAND_LINE_INSTALL:-}" ] && { echo "PracticeGraph: command-line install, not opening"; exit 0; }
user=$(/usr/bin/stat -f %Su /dev/console)
case "$user" in
    "" | root | loginwindow | _mbsetupuser) echo "PracticeGraph: no one at the screen"; exit 0 ;;
esac
uid=$(/usr/bin/id -u "$user") || exit 0

# Register this copy for that user, so practicegraph: links and "open" resolve
# to it rather than to an older copy elsewhere on the disk.
/bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" \
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
    -f "$APP" || true
/bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open "$APP" || true
exit 0
