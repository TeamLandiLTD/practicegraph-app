#!/bin/bash
#
# PracticeGraph installer, "Background refresh" choice: a per-user LaunchAgent
# that runs the engine's agent tick every fifteen minutes, so model guidance,
# benchmarks and prices stay current while the app is closed. The same job
# packaging/macos/install-agent.sh sets up by hand; remove it with that
# script's --uninstall.
#
# Every file under the person's home is written AS that person, never as root.
# Never fails the install: the app works without this, refreshing while open.

set -u
APP="${PRACTICEGRAPH_INSTALL_APP:-/Applications/PracticeGraph.app}"
LABEL="dev.practicegraph.agent"
TEMPLATE="$(cd "$(dirname "$0")" && pwd)/$LABEL.plist"

ENGINE="$APP/Contents/Resources/engine/practicegraph-engine"
[ -x "$ENGINE" ] || ENGINE="$APP/Contents/Resources/practicegraph-engine"
[ -x "$ENGINE" ] || { echo "PracticeGraph: engine not found, background refresh skipped"; exit 0; }

user=$(/usr/bin/stat -f %Su /dev/console)
case "$user" in
    "" | root | loginwindow | _mbsetupuser) echo "PracticeGraph: no one at the screen, background refresh skipped"; exit 0 ;;
esac
uid=$(/usr/bin/id -u "$user") || exit 0
home=$(/usr/bin/dscl . -read "/Users/$user" NFSHomeDirectory | /usr/bin/awk '{print $2}')
[ -d "$home" ] || exit 0
agents="$home/Library/LaunchAgents"
dest="$agents/$LABEL.plist"

as_user() { /usr/bin/sudo -u "$user" "$@"; }
as_user /bin/mkdir -p "$agents" || exit 0
tmp=$(as_user /usr/bin/mktemp "$agents/.practicegraph-agent.XXXXXX") || exit 0
/bin/cat "$TEMPLATE" | as_user /bin/sh -c 'cat > "$1"' _ "$tmp"
if ! as_user /usr/bin/plutil -replace ProgramArguments.0 -string "$ENGINE" "$tmp" \
        || ! /usr/bin/plutil -lint -s "$tmp"; then
    as_user /bin/rm -f "$tmp"; echo "PracticeGraph: could not write the agent"; exit 0
fi
as_user /bin/mv -f "$tmp" "$dest"

/bin/launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
/bin/launchctl bootstrap "gui/$uid" "$dest" || true
/bin/launchctl enable "gui/$uid/$LABEL" || true
echo "PracticeGraph: background refresh installed for $user"
exit 0
