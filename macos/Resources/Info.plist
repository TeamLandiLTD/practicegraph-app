<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist for PracticeGraph.app (macOS shell).

  The build script (packaging/macos/build_macos.sh) copies this into
  Contents/Info.plist and substitutes @VERSION@ / @BUILD@. Keep the bundle
  identifier in sync with the codesigning identity and the notarization
  profile.

  LSUIElement = 1: this is a menu-bar (accessory) app with no Dock tile by
  default. It still opens a real dashboard window; the delegate nudges the
  activation policy so that window behaves normally while visible.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>PracticeGraph</string>
    <key>CFBundleDisplayName</key>
    <string>PracticeGraph</string>
    <key>CFBundleIdentifier</key>
    <string>dev.practicegraph.shell</string>
    <key>CFBundleExecutable</key>
    <string>PracticeGraphShell</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUILD@</string>
    <key>CFBundleIconFile</key>
    <string>PracticeGraph</string>

    <!-- Menu-bar / accessory app: no persistent Dock icon. -->
    <key>LSUIElement</key>
    <true/>

    <!-- macOS 13 floor: SMAppService.mainApp login items. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- High-DPI. -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- The practicegraph: URL scheme (closed protocol verbs, C-5). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>dev.practicegraph.protocol</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>practicegraph</string>
            </array>
        </dict>
    </array>

    <!-- Human-readable copyright / usage note. -->
    <key>NSHumanReadableCopyright</key>
    <string>PracticeGraph — all analysis runs locally on this machine.</string>

    <!-- The app talks only to 127.0.0.1 (the local engine). It never reaches
         the public internet itself; keep ATS strict and allow only local
         loopback so a misconfiguration can't quietly egress. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
