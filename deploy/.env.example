# Copy to deploy/.env, replace placeholders, and keep private.
# Generate each credential: python -c "import secrets; print(secrets.token_urlsafe(32))"
PG_SERVER_ORG_ID=CHANGE-ME-org-id

# One stable opaque ID per independent contributor. Give each endpoint only its
# own secret. Rotate secrets while preserving IDs; never use email/name as IDs.
PG_SERVER_INGEST_TOKENS='{"source-a":"CHANGE-ME-with-at-least-32-random-characters"}'

# Separate administrator credential. Empty disables ALL administrative reads.
PG_SERVER_DASHBOARD_PASSWORD=CHANGE-ME-with-a-separate-random-secret

# Deprecated shared-token fallback: every holder counts as ONE contributor.
# Ignored when PG_SERVER_INGEST_TOKENS is configured.
PG_SERVER_ORG_TOKEN=

PG_SERVER_K_THRESHOLD=5
PG_SERVER_RETENTION_DAYS=400
PG_SERVER_DB=/data/practicegraph-server.db

# Optional organization catalog sources. Empty serves generic starter catalogs.
# PG_SERVER_SKILLS_URL=https://your-org.example/skills.json
PG_SERVER_SKILLS_TTL=900
# PG_SERVER_NEWS_FEEDS=https://your-org.example/rss.xml|update|Example
PG_SERVER_NEWS_TTL=3600
